# Copy to the runtime dir as config.env (mode 0600). Do not commit config.env.
# Destination is the remote Orca websocket host on the tailnet, not a token.
# install.sh fills this from ~/Library/Application Support/orca/orca-environments.json
# and never copies deviceToken / publicKey.

ORCA_NETD_DEST_HOST=
ORCA_NETD_DEST_PORT=6768
ORCA_NETD_SOCKS_HOST=127.0.0.1
ORCA_NETD_SOCKS_PORT=1055
ORCA_NETD_FORWARD_PORT=16768
